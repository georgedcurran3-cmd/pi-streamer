[Unit]
Description=Curran TV media centre
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__BASE__/current
EnvironmentFile=__BASE__/shared/.env
ExecStart=/usr/bin/node --max-old-space-size=128 __BASE__/current/.output/server/index.mjs
Restart=always
RestartSec=5
MemoryMax=220M
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
