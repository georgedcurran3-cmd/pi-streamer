[Unit]
Description=Curran TV kiosk display
After=graphical.target curran-tv.service
Wants=curran-tv.service

[Service]
Type=simple
User=__USER__
Environment=DISPLAY=:0
WorkingDirectory=__APP_DIR__
ExecStart=/bin/bash __APP_DIR__/deploy/kiosk.sh
Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
