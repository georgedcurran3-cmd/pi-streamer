# Copy this file to .env on the Raspberry Pi and fill in the values.
# Never commit the real .env — the update script always leaves it untouched.

# The film and TV database (themoviedb.org) — free to register.
TMDB_API_KEY=

# Optional. Only needed for YouTube search inside the app.
# Without it, YouTube still plays through the signed-in full YouTube view.
YOUTUBE_API_KEY=

# Backend connection (copied from your hosted project settings)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Port the TV app listens on
PORT=3000
